# cektrans · trans_sulteng_tracker
# Copy this to .env (LOCAL DEV ONLY) — never commit a real .env.
# Production values are injected at runtime via the deploy environment
# (GitHub Actions secrets / VPS env vars). NEVER bake secrets into images.

# ── Backend proxy (apps/proxy) ────────────────────────────────────
# Bind address inside the container.
BIND_ADDR=0.0.0.0:8080

# Upstream BRT REST + Socket.IO endpoints.
# Real values are operator-only — fill from your private deploy env.
BRT_REST_BASE=http://example.invalid/path/
BRT_SOCKET_BASE=https://example.invalid:5100/

# 32-byte UTF-8 AES-256-CBC key used by the upstream GpsApi.
# DO NOT commit. Source it from your own secret store and rotate
# when the upstream rotates its key.
BRT_KEY=REPLACE_WITH_32_BYTE_UTF8_SECRET

# CORS allow-origin for the proxy. In prod set to the public site origin.
ALLOW_ORIGIN=https://example.invalid

# tracing-subscriber filter.
RUST_LOG=info,cektrans_proxy=debug

# ── Frontend build (apps/web) — only PUBLIC values ────────────────
# These end up in the static bundle. Do NOT put secrets here.
# Used only by `vite` dev server to know where to forward /api and /socket.io.
VITE_PROXY_TARGET=http://localhost:8080

# Optional: short SHA of the build, surfaced in the footer.
VITE_BUILD_SHA=local

# Google Analytics 4 measurement ID. Leave empty in dev to skip loading
# gtag entirely. In CI/CD this comes from a repo variable (vars.VITE_GA_ID)
# baked at build time.
VITE_GA_ID=
